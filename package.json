{
  "name": "modern-vyapari",
  "version": "0.1.0-alpha.5",
  "description": "Open-source AI trading partner for crypto: you author the thesis, the agent monitors it, deterministic code executes. Electron desktop app.",
  "author": "0ByteBlitz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0ByteBlitz/modern-vyapari.git"
  },
  "bugs": {
    "url": "https://github.com/0ByteBlitz/modern-vyapari/issues"
  },
  "homepage": "https://github.com/0ByteBlitz/modern-vyapari#readme",
  "keywords": [
    "trading",
    "crypto",
    "ai-agent",
    "claude",
    "anthropic",
    "electron",
    "trading-bot",
    "risk-management",
    "paper-trading",
    "revolut-x"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -b tsconfig.node.json && node scripts/prune-orphan-output.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean && node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "generate-icons": "node scripts/generate-icons.mjs",
    "inspect-db": "node --experimental-sqlite scripts/inspect-db.mjs",
    "test": "npm run build:main && node scripts/ensure-electron.mjs && node --test dist/main/test/**/*.test.js",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "klinecharts": "^10.1.0",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "technicalindicators": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.modernvyapari.app",
    "productName": "Modern Vyapari",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!dist/main/test/**"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Finance"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.finance"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
